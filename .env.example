# ===========================================
# LAPLACIAN AI - Environment Configuration
# ===========================================

# ===========================================
# Google OAuth Configuration (Required for login)
# ===========================================
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://yourdomain.com/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# API Keys Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Custom Search API (Optional - for reliable web search)
# Get API Key: https://console.cloud.google.com/apis/credentials
# Get CSE ID: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ===========================================
# GPT/Ollama Server Configuration
# ===========================================
GPT_SERVER_URL=http://localhost:11434/api/chat
GPT_MODEL=gpt-oss:20b-cloud

# ===========================================
# AI Models Configuration
# ===========================================
# Lite Model - Fast responses (phi3:mini)
LITE_MODEL=phi3:mini

# Coder Model - Code specialist
CODER_MODEL=qwen3-coder:480b-cloud

# DocIQ Model - Document understanding with structured output
DOCIQ_MODEL=gpt-oss:20b-cloud

# Default AI Model for chat (gpt, gemini, or coder)
DEFAULT_AI_MODEL=gpt

# ===========================================
# Voice Settings
# ===========================================
VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ===========================================
# Flask Configuration
# ===========================================
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=laplacian_ai
